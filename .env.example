# Configure your own Chat Completions-compatible model. No hosted service is included.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Only enable for a trusted local model endpoint that requires no key.
LLM_ALLOW_NO_KEY=false
HOST=127.0.0.1
PORT=3030
DATABASE_PATH=./data/companion.db
B_GPE_ROOT=./blueprint
USER_DISPLAY_NAME=User
COMPANION_DISPLAY_NAME=知伴
# Separate local runtime access token; this is NOT your model API key.
API_AUTH_TOKEN=
AUTO_START_SCHEDULER=false
CHROMA_ENABLED=false
ASSET_CHROMA_ENABLED=false
ASSET_DOCUMENT_CHROMA_ENABLED=false
DIARY_CHROMA_ENABLED=false
DIARY_MEMORY_CHROMA_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
